# Copie ce fichier en .env et remplis tes vraies valeurs
# Ces infos viennent de ton projet Supabase (Settings > API)
# Sans ces deux variables, salles et scores restent en mémoire (dev / tests).

SUPABASE_URL=https://XXXXXXXXXXXXXXXX.supabase.co
SUPABASE_SERVICE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# URL de ton frontend (pour autoriser les connexions)
# En développement local : http://localhost:5173
# En production : https://ton-app.vercel.app
FRONTEND_URL=http://localhost:5173

# Port du serveur (Railway le définit automatiquement)
PORT=3001

# Optionnel (dev sans Supabase) : fichier JSON où garder salles et scores entre deux redémarrages
# ROOMS_FILE=./.rooms.json

# Optionnel : délai avant de retirer un joueur déconnecté (ms, défaut 30000)
# GRACE_PERIOD_MS=30000
# Optionnel : délai laissé aux joueurs pour revenir après un redémarrage (ms, défaut 120000)
# RESTART_GRACE_MS=120000
